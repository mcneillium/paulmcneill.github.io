# Cloudflare Pages / Netlify response headers.
# GitHub Pages ignores this file. Kept here so a hosting migration
# inherits the security posture without rework. Mirrors the meta-tag
# CSP in _includes/head.html.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://img.youtube.com https://i.ytimg.com https://img.shields.io https://ghchart.rshah.org https://github-readme-stats.vercel.app; connect-src 'self' https://*.workers.dev; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'

# /lab/ is the only page that loads TensorFlow.js: it needs the
# jsDelivr CDN (script + wasm fetch), the public TFJS model host on
# storage.googleapis.com, 'unsafe-eval' (TF.js 4.20 evaluates a string
# as JavaScript at init — 'wasm-unsafe-eval' alone is not enough), and
# blob: workers. The "!" detach line is Cloudflare Pages syntax to
# replace (not stack) the wildcard CSP above; on Netlify replace it
# with a more-specific-rule override.
/lab/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://img.youtube.com https://i.ytimg.com https://img.shields.io https://ghchart.rshah.org https://github-readme-stats.vercel.app; connect-src 'self' https://*.workers.dev https://storage.googleapis.com https://cdn.jsdelivr.net; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'
